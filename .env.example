# Copy to .env, which git ignores, and fill in the values from
# https://api.eumetsat.int/api-key/ (free EUMETSAT account).
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=

# A NASA Earthdata login (free account at https://urs.earthdata.nasa.gov/).
# The city lights are built once from NASA's Black Marble tiles, which LAADS
# serves only to a logged-in account; the code fetches the token itself.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Where the products and the catalogue go. Leave empty for the directory
# ./out; set s3://bucket/prefix for a bucket.
GEORING_OUTPUT_URL=
# For a bucket: a key limited to it, allowed to read and write objects. The
# endpoint is for a service other than AWS, such as
# https://<account>.r2.cloudflarestorage.com for Cloudflare R2.
GEORING_S3_ENDPOINT_URL=
GEORING_S3_ACCESS_KEY_ID=
GEORING_S3_SECRET_ACCESS_KEY=

# The user the worker writes ./out as. Leave empty for 1000; otherwise the
# numbers `id -u` and `id -g` show for the owner of ./out.
GEORING_UID=
GEORING_GID=

# Renders at once. Leave empty for one, which fits 8 CPUs and 32 GB. Each one
# more takes 8 CPUs and up to 22 GB: two want 16 CPUs and 64 GB.
GEORING_PARALLEL_RENDERS=
